{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__TROVE__/hooks/lint-file.sh",
            "timeout": 30,
            "statusMessage": "Formatting…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TROVE__/hooks/run-tests.sh",
            "timeout": 600,
            "asyncRewake": true,
            "rewakeSummary": "Tests failed",
            "statusMessage": "Running tests…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git remote -v)", "Bash(git stash list)",
      "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr diff:*)",
      "Bash(gh run list:*)", "Bash(gh run view:*)", "Bash(gh issue view:*)", "Bash(gh issue list:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)",
      "Bash(rg:*)", "Bash(grep:*)", "Bash(find:*)", "Bash(jq:*)", "Bash(tree:*)",
      "Bash(pnpm test:*)",
      "Bash(npm test:*)", "Bash(npm run:*)", "Bash(bun run:*)", "Bash(bunx:*)",
      "Bash(pytest:*)", "Bash(uv run:*)", "Bash(ruff:*)",
      "Bash(cargo test:*)", "Bash(cargo check:*)", "Bash(go test:*)", "Bash(make:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout:*)",
      "Bash(pnpm run:*)", "Bash(bun:*)", "Bash(node:*)",
      "Bash(npm info:*)", "Bash(npm show:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
